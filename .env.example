# SIH 26189 — Local development environment variables
# Copy to .env and fill in real values. Never commit .env with secrets.

# --- PostgreSQL (canonical structured store) ---
DATABASE_URL=postgresql://investigator:secure_password@localhost:5432/criminal_network
# Alternatively, structured vars (used if DATABASE_URL not set):
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=investigator
POSTGRES_PASSWORD=secure_password
POSTGRES_DB=criminal_network

# --- FastAPI (backend-python) ---
APP_DATA_DIR=data/synthetic
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
APP_LOG_LEVEL=info

# --- Neo4j (analytical graph projection) ---
APP_NEO4J_URI=bolt://localhost:7687
APP_NEO4J_USER=neo4j
APP_NEO4J_PASSWORD=password
NEO4J_ENABLED=true
# For docker-compose, use bolt://neo4j:7687

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Notes ---
# - PostgreSQL is canonical persistence (12 entity types, 11 relationship types, TEXT IDs)
# - Neo4j is analytical projection (relationship/network queries)
# - In-memory fallback is used when DATABASE_URL / Neo4j are unavailable (tests)
# - Do NOT log passwords or DATABASE_URL. Use parameterized SQL.
